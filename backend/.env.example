# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/mood-tracker
# Railway: use the MONGO_URL / MONGO_PUBLIC_URL variable from the Mongo service
MONGODB_URI=mongodb://127.0.0.1:27017/mood-tracker
MONGODB_DB_NAME=mood-tracker

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-24-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-24-chars
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# ── Web ──────────────────────────────────────────────────────────────────────
# Comma-separated. Add your Vercel domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to false to close sign-ups once your own account exists.
ALLOW_REGISTRATION=true
